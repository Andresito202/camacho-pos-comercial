# Camacho POS Comercial — NestJS commercial-api
# Build context: repository root
# docker build -f infrastructure/docker/Dockerfile.api -t camacho-pos-api .

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/commercial-api/package.json apps/commercial-api/
COPY packages/configuration/package.json packages/configuration/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
RUN pnpm install --frozen-lockfile --filter @camacho-pos-comercial/commercial-api...

FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/commercial-api/node_modules ./apps/commercial-api/node_modules
COPY --from=deps /app/packages/configuration/node_modules ./packages/configuration/node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/commercial-api ./apps/commercial-api
COPY packages/configuration ./packages/configuration
COPY packages/contracts ./packages/contracts
COPY packages/database ./packages/database
RUN pnpm --filter @camacho-pos-comercial/database prisma:generate \
  && pnpm --filter @camacho-pos-comercial/contracts build \
  && pnpm --filter @camacho-pos-comercial/configuration build \
  && pnpm --filter @camacho-pos-comercial/database build \
  && pnpm --filter @camacho-pos-comercial/commercial-api build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs apiuser
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml /app/.npmrc ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/commercial-api/package.json ./apps/commercial-api/
COPY --from=builder /app/apps/commercial-api/dist ./apps/commercial-api/dist
COPY --from=builder /app/apps/commercial-api/node_modules ./apps/commercial-api/node_modules
COPY --from=builder /app/packages/configuration ./packages/configuration
COPY --from=builder /app/packages/contracts ./packages/contracts
COPY --from=builder /app/packages/database ./packages/database
USER apiuser
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/commercial-api/dist/main.js"]
