# Camacho POS Comercial — environment template
# Copy to `.env` and fill values. NEVER commit real credentials.

NODE_ENV=development
PORT=4000

# Local Postgres (this smoke used 5432). If using repo docker-compose, host port is often 5433.
POSTGRES_USER=comercial
POSTGRES_PASSWORD=
POSTGRES_DB=camacho_pos_comercial
# Set a local URL with the generated password (URL-encode reserved characters).
DATABASE_URL=

# Central Authority (pos-platform). Empty = session bridge disabled / provisioning stays PAID+PENDING.
CENTRAL_AUTHORITY_ORIGIN=
CENTRAL_SESSION_BRIDGE_ENABLED=false
CENTRAL_PROVISIONING_PATH=/v1/commercial/provisioning
# Aspirational only — Central subscription Factus gateway is internal/managed, not a public commercial API.
CENTRAL_FACTUS_PAY_GATEWAY_PATH=/v1/subscriptions/factus-pay/collections

# FACTUS Pay — see docs/commercial/factus-pay-integration-status.md
# Gates: MOCK (no creds, non-prod) | SANDBOX (real sandbox HTTP) | PRODUCTION (disabled by default)
FACTUS_PAY_MODE=SANDBOX
FACTUS_PAY_SANDBOX_ENABLED=true
FACTUS_PAY_PRODUCTION_ENABLED=false
FACTUS_PAY_SANDBOX_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_PRODUCTION_BASE_URL=https://pay-api.factus.com.co
# Official auth is email+password (POST /auth). CLIENT_ID/SECRET are aliases for the same values.
FACTUS_PAY_SANDBOX_EMAIL=
FACTUS_PAY_SANDBOX_PASSWORD=
FACTUS_PAY_SANDBOX_CLIENT_ID=
FACTUS_PAY_SANDBOX_CLIENT_SECRET=
FACTUS_PAY_SANDBOX_WEBHOOK_KEY=
FACTUS_PAY_PRODUCTION_EMAIL=
FACTUS_PAY_PRODUCTION_PASSWORD=
FACTUS_PAY_PRODUCTION_CLIENT_ID=
FACTUS_PAY_PRODUCTION_CLIENT_SECRET=
FACTUS_PAY_PRODUCTION_WEBHOOK_KEY=
# Prefer Authorization: Bearer or X-Factus-Pay-Webhook-Key. Query ?key= is deprecated (log/Referer leak).
FACTUS_PAY_WEBHOOK_ALLOW_QUERY_KEY=false
FACTUS_PAY_USE_CENTRAL_GATEWAY=false

# DEV PLACEHOLDER — replace before any production messaging (blocked when NODE_ENV=production)
WHATSAPP_BUSINESS_NUMBER=573000000000_DEV_PLACEHOLDER
PUBLIC_SITE_ORIGIN=http://127.0.0.1:3000

# --- Web (Next.js) — also copy relevant keys to apps/web/.env.local for `next dev` ---
# Browser-reachable API (host). Inside Docker Compose SSR uses COMMERCIAL_API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
COMMERCIAL_API_INTERNAL_URL=
# Compose example: COMMERCIAL_API_INTERNAL_URL=http://commercial-api:4000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_CENTRAL_AUTHORITY_ORIGIN=
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
# Build-only draft catalog when API offline (never rely on this in production runtime)
ALLOW_DRAFT_BUILD_FALLBACK=1

# Optional session / admin secrets (leave empty unless Central bridge docs require them)
# SESSION_COOKIE_SECRET=
# ADMIN_BOOTSTRAP_TOKEN=

# OPTIONAL staging-only AdminGuard fixture. NEVER set to 1 in production.
# When ALLOW_ADMIN_TEST_FIXTURE=1 AND NODE_ENV!==production, AdminGuard accepts
# header X-Admin-Test-Fixture: GLOBAL_SUPERADMIN for UI demos without Central.
# Default: unset / false (fail-closed). EnvSchema refuses this flag when NODE_ENV=production.
ALLOW_ADMIN_TEST_FIXTURE=0
# Web companion (apps/web/.env.local) — only when API fixture is also enabled:
# NEXT_PUBLIC_ALLOW_ADMIN_TEST_FIXTURE=1

# Anti-bot (prefer Cloudflare Turnstile). Required in production when CAPTCHA_REQUIRED_IN_PRODUCTION=true.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_REQUIRED_IN_PRODUCTION=true
# Optional web mirror for client widgets (API also exposes GET /v1/crm/captcha-config):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trial activation webhook from Central (min 32 chars). Empty = fail-closed, no local simulation.
CENTRAL_TRIAL_WEBHOOK_KEY=
# Shared with Central commercial bridge (X-Central-Commercial-Bridge-Key), min 32.
COMMERCIAL_BRIDGE_KEY=
COMMERCIAL_PROVISIONING_WORKER_ENABLED=false
# Durable Postgres rate limits (default true)
RATE_LIMIT_DURABLE=true

