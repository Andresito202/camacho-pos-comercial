te","title":"¿Qué canales de soporte existen?","content":["$","p",null,{"children":"Soporte comercial por WhatsApp, correo y el centro de ayuda. Incidentes de operación se atienden según el plan contratado y el horario publicado."}]}]}],["$","div",null,{"className":"mt-6","children":["$","$Le",null,{"href":"/preguntas-frecuentes","className":"font-medium text-[var(--teal)] underline-offset-2 hover:underline","children":"Ver todas las preguntas"}]}]]]}]}]
