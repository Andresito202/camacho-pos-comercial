{
  "name": "camacho-pos-comercial",
  "private": true,
  "version": "0.1.0",
  "description": "Camacho POS Colombia — commercial portal API and related packages",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @camacho-pos/web dev",
    "dev:web": "pnpm --filter @camacho-pos/web dev",
    "dev:api": "pnpm --filter @camacho-pos-comercial/commercial-api start:dev",
    "build": "pnpm -r --filter @camacho-pos-comercial/contracts --filter @camacho-pos-comercial/configuration --filter @camacho-pos-comercial/database --filter @camacho-pos-comercial/commercial-api run build",
    "build:web": "pnpm --filter @camacho-pos/web build",
    "start:dev": "pnpm --filter @camacho-pos-comercial/commercial-api start:dev",
    "lint": "pnpm --filter @camacho-pos/web lint && pnpm --filter @camacho-pos-comercial/commercial-api lint",
    "test": "pnpm -r --filter @camacho-pos-comercial/commercial-api --filter @camacho-pos-comercial/contracts run test",
    "test:e2e": "pnpm --filter @camacho-pos/web test:e2e",
    "prisma:generate": "pnpm --filter @camacho-pos-comercial/database prisma:generate",
    "prisma:migrate": "pnpm --filter @camacho-pos-comercial/database prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter @camacho-pos-comercial/database prisma:migrate:deploy",
    "prisma:seed": "pnpm --filter @camacho-pos-comercial/database prisma:seed",
    "prisma:validate": "pnpm --filter @camacho-pos-comercial/database prisma:validate",
    "db:setup": "pnpm prisma:migrate:deploy && pnpm prisma:seed",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:web": "pnpm --filter @camacho-pos/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
