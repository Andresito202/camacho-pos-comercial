// Camacho POS Colombia — commercial portal schema
// Money: amountCents = integer minor units (1 COP peso). Never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FeatureCommercialStatus {
  AVAILABLE
  IN_CERTIFICATION
  COMING_SOON
  UNPUBLISHED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  ONE_TIME
  PERPETUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  WON
  LOST
  ARCHIVED
}

enum TrialStatus {
  /// Form received; clock has NOT started. Waiting for Central license confirmation.
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
  BLOCKED
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  STATUS_CHANGE
  DEMO
  SYSTEM
}

enum CartStatus {
  OPEN
  CHECKOUT
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROVISIONING
  FULFILLED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentAttemptStatus {
  STARTED
  SUBMITTED
  SUCCEEDED
  FAILED
  EXPIRED
  DUPLICATE
}

enum PaymentProvider {
  FACTUS_PAY
  MANUAL
  SANDBOX_MOCK
}

enum FactusEnvironment {
  SANDBOX
  PRODUCTION
}

enum ProvisioningStatus {
  PENDING
  QUEUED
  SENT
  ACKNOWLEDGED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  COOKIES
  REFUND
  LICENSE
  OTHER
}

enum ConsentType {
  COOKIES
  MARKETING
  PRIVACY
  TERMS
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  WEBHOOK
  INTERNAL
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

enum AuditActorType {
  SYSTEM
  CUSTOMER
  ADMIN
  WEBHOOK
  WORKER
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum ProductKind {
  SOFTWARE_LICENSE
  HARDWARE
  KIT
  ACCESSORY
  SERVICE
}

// ─── CRM / Customers ─────────────────────────────────────────────────────────

model CommercialCustomer {
  id             String    @id @default(cuid())
  email          String    @unique
  phoneE164      String?
  fullName       String
  documentType   String?
  documentNumber String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  businessProfiles BusinessProfile[]
  contactRequests  ContactRequest[]
  leads            Lead[]
  demoRequests     DemoRequest[]
  trialEnrollments TrialEnrollment[]
  carts            Cart[]
  orders           Order[]
  payments         Payment[]
  couponRedemptions CouponRedemption[]
  benefits         CustomerBenefit[]
  supportTickets   SupportTicket[]
  consents         ConsentRecord[]

  @@index([phoneE164])
  @@index([deletedAt])
}

model BusinessProfile {
  id           String    @id @default(cuid())
  customerId   String
  legalName    String
  tradeName    String?
  nit          String?
  cityCode     String?
  departmentCode String?
  addressLine  String?
  sector       String?
  branchCount  Int       @default(1)
  cajaCount    Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  customer CommercialCustomer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId])
  @@index([nit])
  @@index([deletedAt])
}

model ContactRequest {
  id          String    @id @default(cuid())
  customerId  String?
  fullName    String
  email       String
  phoneE164   String?
  companyName String?
  message     String
  sourcePath  String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer CommercialCustomer? @relation(fields: [customerId], references: [id])

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Lead {
  id                    String     @id @default(cuid())
  customerId            String?
  email                 String
  fullName              String
  phoneE164             String?
  companyName           String?
  businessType          String?
  source                String?
  status                LeadStatus @default(NEW)
  notes                 String?
  /// Catalog plan id when the lead originates from /planes hire flow
  planId                String?
  /// MONTHLY | ANNUAL | PERPETUAL
  modality              String?
  /// SOFTWARE | COMPLETE
  solutionType          String?
  departmentCode        String?
  cityCode              String?
  cajaQty               Int?
  branchQty             Int?
  consentDataTreatment  Boolean    @default(false)
  consentCommercial     Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  customer   CommercialCustomer? @relation(fields: [customerId], references: [id])
  activities LeadActivity[]
  demos      DemoRequest[]

  @@index([email])
  @@index([status])
  @@index([planId])
  @@index([deletedAt])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  type      LeadActivityType
  body      String
  actorType AuditActorType   @default(SYSTEM)
  actorId   String?
  createdAt DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
}

model DemoRequest {
  id           String    @id @default(cuid())
  leadId       String?
  customerId   String?
  fullName     String
  email        String
  phoneE164    String?
  preferredAt  DateTime?
  sector       String?
  notes        String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  lead     Lead?               @relation(fields: [leadId], references: [id])
  customer CommercialCustomer? @relation(fields: [customerId], references: [id])

  @@index([email])
  @@index([status])
}

/// Commercial 5-day trial enrollment (CRM). Clock starts only after Central confirms POS license.
model TrialEnrollment {
  id                   String      @id @default(cuid())
  leadId               String?
  customerId           String?
  fullName             String
  email                String
  phoneE164            String?
  companyName          String?
  sector               String?
  city                 String?
  notes                String?
  status               TrialStatus @default(PENDING_ACTIVATION)
  /// Null until Central confirms activation — form submit must NOT start the clock.
  startsAt             DateTime?
  expiresAt            DateTime?
  blockedAt            DateTime?
  blockedReason        String?
  /// SHA-256 of one-time access token required to read status (anti-enumeration).
  accessTokenHash      String
  /// Stable identity key (sha256 email|phone) for anti-repeat / abuse checks.
  identityKey          String
  centralLicenseRef    String?
  activatedAt          DateTime?
  /// Only CENTRAL_LICENSE_CONFIRMED is accepted — never local simulation.
  activationSource     String?
  consentDataTreatment Boolean     @default(false)
  consentTerms         Boolean     @default(false)
  sourcePath           String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  customer CommercialCustomer? @relation(fields: [customerId], references: [id])

  @@unique([accessTokenHash])
  @@index([email])
  @@index([identityKey])
  @@index([status])
  @@index([expiresAt])
}

/// Durable shared rate-limit counters (Postgres). Prefer over process-local maps in multi-instance.
model RateLimitCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

/// Captcha token replay protection (Turnstile/reCAPTCHA response hashes).
model CaptchaTokenUse {
  tokenHash String   @id
  provider  String
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Plan {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  tagline           String?
  description       String
  sortOrder         Int               @default(0)
  publicationStatus PublicationStatus @default(DRAFT)
  licensesPerUnit   Int               @default(1) // one license = one caja unless contract says otherwise
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  features PlanFeature[]
  prices   PlanPrice[]
  offerings LicenseOffering[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([publicationStatus])
  @@index([deletedAt])
}

model PlanFeature {
  id                String                  @id @default(cuid())
  planId            String
  code              String
  label             String
  description       String?
  commercialStatus  FeatureCommercialStatus @default(UNPUBLISHED)
  claimNote         String? // honesty note, e.g. AVAILABLE as claim only where POS-verified
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, code])
  @@index([commercialStatus])
}

model PlanPrice {
  id                String            @id @default(cuid())
  planId            String
  version           Int
  billingInterval   BillingInterval
  amountCents       Int // COP integer minor units (1 unit = 1 COP peso)
  currencyCode      String            @default("COP")
  publicationStatus PublicationStatus @default(DRAFT)
  effectiveFrom     DateTime          @default(now())
  effectiveTo       DateTime?
  createdAt         DateTime          @default(now())
  createdByAdminId  String?

  plan       Plan        @relation(fields: [planId], references: [id])
  history    PlanPriceHistory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([planId, billingInterval, version])
  @@index([publicationStatus])
  @@index([planId, publicationStatus])
}

model PlanPriceHistory {
  id           String   @id @default(cuid())
  planPriceId  String
  amountCents  Int
  changedAt    DateTime @default(now())
  changedBy    String?
  reason       String?

  planPrice PlanPrice @relation(fields: [planPriceId], references: [id])

  @@index([planPriceId, changedAt])
}

model LicenseOffering {
  id                String            @id @default(cuid())
  planId            String
  code              String            @unique
  name              String
  maxCajas          Int               @default(1)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  plan Plan @relation(fields: [planId], references: [id])
}

model ProductCategory {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  description       String?
  parentId          String?
  sortOrder         Int               @default(0)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([publicationStatus])
}

model Product {
  id                String            @id @default(cuid())
  slug              String            @unique
  sku               String            @unique
  name              String
  description       String
  kind              ProductKind
  categoryId        String?
  publicationStatus PublicationStatus @default(DRAFT)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  category ProductCategory? @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  kitAsKit Kit?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([publicationStatus, kind])
  @@index([deletedAt])
}

model ProductVariant {
  id                String            @id @default(cuid())
  productId         String
  sku               String            @unique
  name              String
  amountCents       Int
  currencyCode      String            @default("COP")
  version           Int               @default(1)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  product    Product               @relation(fields: [productId], references: [id])
  stock      ProductStock?
  history    ProductPriceHistory[]
  kitItems   KitItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, publicationStatus])
}

model ProductPriceHistory {
  id               String   @id @default(cuid())
  productVariantId String
  amountCents      Int
  changedAt        DateTime @default(now())
  changedBy        String?
  reason           String?

  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([productVariantId, changedAt])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  mediaId   String?
  url       String
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product     @relation(fields: [productId], references: [id])
  media   MediaAsset? @relation(fields: [mediaId], references: [id])

  @@index([productId])
}

model ProductStock {
  id               String   @id @default(cuid())
  productVariantId String   @unique
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  trackInventory   Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  variant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Kit {
  id                String            @id @default(cuid())
  productId         String            @unique
  slug              String            @unique
  name              String
  description       String
  amountCents       Int
  currencyCode      String            @default("COP")
  priceVersion      Int               @default(1)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  product  Product          @relation(fields: [productId], references: [id])
  items    KitItem[]
  history  KitPriceHistory[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([publicationStatus])
}

model KitPriceHistory {
  id          String   @id @default(cuid())
  kitId       String
  amountCents Int
  changedAt   DateTime @default(now())
  changedBy   String?
  reason      String?

  kit Kit @relation(fields: [kitId], references: [id])

  @@index([kitId, changedAt])
}

model KitItem {
  id               String @id @default(cuid())
  kitId            String
  productVariantId String
  quantity         Int    @default(1)

  kit     Kit            @relation(fields: [kitId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([kitId, productVariantId])
}

// ─── Cart / Checkout ─────────────────────────────────────────────────────────

model Cart {
  id              String     @id @default(cuid())
  customerId      String?
  sessionToken    String     @unique
  status          CartStatus @default(OPEN)
  currencyCode    String     @default("COP")
  subtotalCents   Int        @default(0)
  discountCents   Int        @default(0)
  shippingCents   Int        @default(0)
  taxCents        Int        @default(0)
  totalCents      Int        @default(0)
  couponCode      String?
  coverageZoneId  String?
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customer     CommercialCustomer? @relation(fields: [customerId], references: [id])
  items        CartItem[]
  coverageZone CoverageZone?       @relation(fields: [coverageZoneId], references: [id])
  orders       Order[]

  @@index([customerId])
  @@index([status])
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  planId           String?
  planPriceId      String?
  productId        String?
  productVariantId String?
  kitId            String?
  quantity         Int      @default(1)
  unitAmountCents  Int // server-copied from priced entity at add time
  lineTotalCents   Int
  priceVersion     Int
  label            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  plan           Plan?           @relation(fields: [planId], references: [id])
  planPrice      PlanPrice?      @relation(fields: [planPriceId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  kit            Kit?            @relation(fields: [kitId], references: [id])

  @@index([cartId])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  cartId            String?
  customerId        String
  businessProfileId String?
  status            OrderStatus @default(PENDING_PAYMENT)
  currencyCode      String      @default("COP")
  subtotalCents     Int
  discountCents     Int         @default(0)
  shippingCents     Int         @default(0)
  taxCents          Int         @default(0)
  totalCents        Int
  couponCode        String?
  idempotencyKey    String      @unique
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  cart            Cart?               @relation(fields: [cartId], references: [id])
  customer        CommercialCustomer  @relation(fields: [customerId], references: [id])
  businessProfile BusinessProfile?    @relation(fields: [businessProfileId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  provisioning    ProvisioningRequest[]
  shipments       Shipment[]
  couponRedemptions CouponRedemption[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String
  planId           String?
  planPriceId      String?
  productId        String?
  productVariantId String?
  kitId            String?
  quantity         Int
  unitAmountCents  Int
  lineTotalCents   Int
  priceVersion     Int
  label            String

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan           Plan?           @relation(fields: [planId], references: [id])
  planPrice      PlanPrice?      @relation(fields: [planPriceId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  kit            Kit?            @relation(fields: [kitId], references: [id])

  @@index([orderId])
}

// ─── Payments / FACTUS Pay ───────────────────────────────────────────────────

model Payment {
  id                 String           @id @default(cuid())
  orderId            String
  customerId         String
  provider           PaymentProvider
  environment        FactusEnvironment
  status             PaymentStatus    @default(PENDING)
  amountCents        Int
  currencyCode       String           @default("COP")
  referenceCode      String           @unique
  providerCollectionId String?
  qrPayload          String?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  order    Order              @relation(fields: [orderId], references: [id])
  customer CommercialCustomer @relation(fields: [customerId], references: [id])
  attempts PaymentAttempt[]
  events   PaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([environment])
}

model PaymentAttempt {
  id              String               @id @default(cuid())
  paymentId       String
  status          PaymentAttemptStatus @default(STARTED)
  providerPayload Json?
  errorCode       String?
  createdAt       DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model PaymentEvent {
  id               String   @id @default(cuid())
  paymentId        String?
  idempotencyKey   String   @unique
  provider         PaymentProvider
  environment      FactusEnvironment
  eventType        String
  referenceCode    String
  amountCents      Int?
  rawPayload       Json
  processedAt      DateTime?
  createdAt        DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([referenceCode])
  @@index([createdAt])
}

model ProvisioningRequest {
  id             String             @id @default(cuid())
  orderId        String
  status         ProvisioningStatus @default(PENDING)
  idempotencyKey String             @unique
  payload        Json
  attemptCount   Int                @default(0)
  lastError      String?
  nextRetryAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([status, nextRetryAt])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingCode   String?
  coverageZoneId String?
  shippingRateId String?
  amountCents    Int            @default(0)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order        Order         @relation(fields: [orderId], references: [id])
  coverageZone CoverageZone? @relation(fields: [coverageZoneId], references: [id])
  shippingRate ShippingRate? @relation(fields: [shippingRateId], references: [id])

  @@index([orderId])
  @@index([status])
}

// ─── Promotions ──────────────────────────────────────────────────────────────

model Promotion {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  description       String?
  publicationStatus PublicationStatus @default(DRAFT)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  coupons Coupon[]

  @@index([publicationStatus])
}

model Coupon {
  id              String     @id @default(cuid())
  promotionId     String?
  code            String     @unique
  type            CouponType
  percentOff      Int? // 0-100
  amountOffCents  Int?
  minSubtotalCents Int?
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  promotion   Promotion?         @relation(fields: [promotionId], references: [id])
  redemptions CouponRedemption[]

  @@index([active, endsAt])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  customerId String
  orderId    String
  amountCents Int
  createdAt  DateTime @default(now())

  coupon   Coupon              @relation(fields: [couponId], references: [id])
  customer CommercialCustomer  @relation(fields: [customerId], references: [id])
  order    Order               @relation(fields: [orderId], references: [id])

  @@unique([couponId, orderId])
  @@index([customerId])
}

model Benefit {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  description       String?
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customers CustomerBenefit[]
}

model CustomerBenefit {
  id         String    @id @default(cuid())
  customerId String
  benefitId  String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  redeemedAt DateTime?

  customer CommercialCustomer @relation(fields: [customerId], references: [id])
  benefit  Benefit            @relation(fields: [benefitId], references: [id])

  @@unique([customerId, benefitId])
}

// ─── Support / Content ───────────────────────────────────────────────────────

model SupportTicket {
  id              String                @id @default(cuid())
  customerId      String?
  email           String
  subject         String
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(NORMAL)
  /// SHA-256 of one-time access token required for public GET (anti-IDOR).
  accessTokenHash String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  closedAt        DateTime?
  deletedAt       DateTime?

  customer CommercialCustomer? @relation(fields: [customerId], references: [id])
  messages SupportMessage[]

  @@unique([accessTokenHash])
  @@index([status])
  @@index([email])
}

model SupportMessage {
  id         String         @id @default(cuid())
  ticketId   String
  body       String
  actorType  AuditActorType
  actorId    String?
  createdAt  DateTime       @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Faq {
  id                String            @id @default(cuid())
  slug              String            @unique
  question          String
  answer            String
  category          String?
  sortOrder         Int               @default(0)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([publicationStatus])
}

model BlogPost {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  excerpt           String?
  body              String
  coverImageUrl     String?
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  seoId             String?           @unique

  seo SeoMetadata? @relation(fields: [seoId], references: [id])

  @@index([publicationStatus, publishedAt])
}

// ─── Coverage / Shipping ─────────────────────────────────────────────────────

model Department {
  id        String   @id // DIVIPOLA department code
  name      String
  createdAt DateTime @default(now())

  cities City[]
}

model City {
  id           String   @id // DIVIPOLA city code
  departmentId String
  name         String
  createdAt    DateTime @default(now())

  department Department     @relation(fields: [departmentId], references: [id])
  zones      CoverageZone[]

  @@index([departmentId])
}

model CoverageZone {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  cityId       String?
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  city   City?          @relation(fields: [cityId], references: [id])
  rates  ShippingRate[]
  carts  Cart[]
  shipments Shipment[]

  @@index([publicationStatus])
}

model ShippingRate {
  id                String            @id @default(cuid())
  coverageZoneId    String
  name              String
  amountCents       Int
  currencyCode      String            @default("COP")
  minDays           Int?
  maxDays           Int?
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  coverageZone CoverageZone @relation(fields: [coverageZoneId], references: [id])
  shipments    Shipment[]

  @@index([coverageZoneId, publicationStatus])
}

// ─── Media / SEO / Site ──────────────────────────────────────────────────────

model MediaAsset {
  id        String    @id @default(cuid())
  kind      MediaKind
  url       String
  alt       String?
  mimeType  String?
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  productImages ProductImage[]
}

model SeoMetadata {
  id              String  @id @default(cuid())
  path            String  @unique
  title           String
  description     String
  ogImageUrl      String?
  canonicalUrl    String?
  robots          String? @default("index,follow")
  jsonLd          Json?

  blogPosts BlogPost[]
}

model SiteSettings {
  id                 String   @id @default(cuid())
  key                String   @unique @default("default")
  brandName          String
  domain             String
  primaryColor       String
  secondaryColor     String
  accentColor        String
  whatsappNumber     String // must be clearly marked DEV placeholder when provisional
  supportEmail       String
  logoUrl            String?
  promoBannerMessage String?
  promoBannerHref    String?
  promoBannerCta     String?
  publicationStatus  PublicationStatus @default(DRAFT)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model SocialLink {
  id                String            @id @default(cuid())
  platform          String
  url               String
  sortOrder         Int               @default(0)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([platform, url])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  customerId String?
  sessionId  String?
  type       ConsentType
  granted    Boolean
  version    String
  ipHash     String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  customer CommercialCustomer? @relation(fields: [customerId], references: [id])

  @@index([customerId, type])
  @@index([sessionId])
}

model LegalDocument {
  id                String            @id @default(cuid())
  type              LegalDocumentType
  slug              String            @unique
  title             String
  body              String
  version           String
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type, publicationStatus])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorType, actorId])
}

model NotificationOutbox {
  id          String                   @id @default(cuid())
  channel     NotificationChannel
  recipient   String
  template    String
  payload     Json
  status      NotificationOutboxStatus @default(PENDING)
  attemptCount Int                     @default(0)
  lastError   String?
  nextRetryAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status, nextRetryAt])
}
